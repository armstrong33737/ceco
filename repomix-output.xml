    const fallback = DEFAULT_CONFIGS[newType] || DEFAULT_CONFIGS.CARTE_ETUDIANT;
    setConfig(fallback);

    // Récupération des données personnalisées sauvegardées en base
    apiFetch(`/documents/templates/${newType}`)
      .then((data) => {
        if (data && typeof data === "object") {
          setConfig((prev) => ({
            ...fallback,
            ...data,
            showWatermark: data.showWatermark !== undefined ? Boolean(data.showWatermark) : fallback.showWatermark,
            showSeal: data.showSeal !== undefined ? Boolean(data.showSeal) : fallback.showSeal,
            showLogo: data.showLogo !== undefined ? Boolean(data.showLogo) : fallback.showLogo,
          }));
        }
      })
      .catch(() => {
        // En cas d'absence de personnalisation, on conserve la valeur par défaut
      });
