<file path=".github/workflows/build-desktop.yml">
name: Build CECO Desktop (Test)

on:
  workflow_dispatch: # Permet le déclenchement manuel en un clic

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: "pnpm"

      - name: Installer les dépendances
        run: pnpm install --frozen-lockfile

      - name: Générer le client Prisma
        run: pnpm --filter @ceco/backend prisma:generate

      - name: Construire l'installateur pour ${{ matrix.os }}
        run: pnpm --filter @ceco/desktop run build:installer

      - name: Publier dans les Releases (Gratuit)
        uses: softprops/action-gh-release@v2
        with:
          tag_name: "v-test" # Tag temporaire automatique
          name: "Test de build - Installer"
          draft: true # Reste masqué du public tant que vous ne validez pas
          files: |
            packages/desktop/dist/*.exe
            packages/desktop/dist/*.dmg
            packages/desktop/dist/*.deb
            packages/desktop/dist/*.snap
            packages/desktop/dist/*.AppImage
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
</file>

<file path="packages/backend/prisma/schema.prisma">
// ============================================================
// CECO — Schéma Prisma V0
// Principe directeur : chaque table métier porte centerId dès V0,
// même en mode local à centre unique. Rien n'est ajouté en V8.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Tenant racine ----------------

model Center {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logo             String?
  email            String?
  phone            String?

  // Adresse et identité légale — utiles sur les documents officiels
  address          String?
  city             String?
  postalCode       String?
  country          String?
  website          String?
  registrationNumber String? // numéro d'agrément / immatriculation
  directorName     String?
