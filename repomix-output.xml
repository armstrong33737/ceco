  .status { margin-top: 10px; font-size: 12px; min-height: 16px; border-radius: 6px; }
  .status.error { color: var(--danger); background: var(--danger-light); padding: 8px 10px; }
  .status.pending { color: var(--ink-variant); display: flex; align-items: center; gap: 6px; }
  
