const PDFDocument = require("pdfkit");
const QRCode = require("qrcode");
const fs = require("fs");
const path = require("path");

function bufferFromDataUrl(dataUrl) {
  if (!dataUrl || !dataUrl.includes(",")) return null;
  const base64 = dataUrl.split(",")[1];
  return Buffer.from(base64, "base64");
}

// 1. Génération de la Carte d'Apprenant Individuelle (Format CR80 Badge : 85.6mm x 53.98mm = 243 x 153 pt)
async function generateStudentCardPdf(snapshot, qrUrl, outputPath) {
  return new Promise(async (resolve, reject) => {
    try {
      // Dimensions standard carte de crédit / badge ID en points PDF (72 pt/inch)
      const doc = new PDFDocument({
        size: [243, 153],
        margins: { top: 6, bottom: 6, left: 8, right: 8 },
        autoFirstPage: true
      });

      const writeStream = fs.createWriteStream(outputPath);
      doc.pipe(writeStream);

      const center = snapshot.center;
      const student = snapshot.student;
      const insc = snapshot.inscription;
      const tmpl = snapshot.templateConfig || {};

      const logoBuf = bufferFromDataUrl(center.logoDataUrl);
      const sealBuf = bufferFromDataUrl(center.sealDataUrl);
      const photoBuf = bufferFromDataUrl(student.photoDataUrl);
      const qrBuf = await QRCode.toBuffer(qrUrl, { margin: 0, width: 80 });

      // ==========================================
      // PAGE 1 : RECTO DU BADGE
      // ==========================================
      // Fond de carte et contour
      doc.rect(0, 0, 243, 153).fill("#FFFFFF");
      doc.rect(0, 0, 243, 26).fill(tmpl.primaryColor || "#0B1C30");

      // Filigrane discret
      if (tmpl.showWatermark !== false && (logoBuf || sealBuf)) {
        doc.save();
        doc.opacity(tmpl.watermarkOpacity || 0.08);
        const wmBuf = tmpl.watermarkType === "seal" && sealBuf ? sealBuf : logoBuf;
        if (wmBuf) {
          doc.image(wmBuf, 70, 35, { width: 100, fit: [100, 100], align: "center", valign: "center" });
        }
        doc.restore();
      }

      // En-tête Recto
      if (tmpl.showLogo && logoBuf) {
        doc.image(logoBuf, 8, 4, { fit: [18, 18] });
      }
      doc.fillColor("#FFFFFF").fontSize(7).font("Helvetica-Bold").text(center.name.toUpperCase(), 30, 6, { width: 180, truncate: true });
      doc.fillColor("#A5B4FC").fontSize(5.5).font("Helvetica-Bold").text("CARTE D'APPRENANT OFFICIELLE", 30, 15);
      if (tmpl.showSeal && sealBuf) {
        doc.image(sealBuf, 218, 4, { fit: [18, 18] });
      }

      // Photo d'identité
      const photoX = 10;
      const photoY = 34;
      const photoW = 46;
      const photoH = 58;
      doc.rect(photoX - 1, photoY - 1, photoW + 2, photoH + 2).fillAndStroke("#F1F5F9", "#CBD5E1");
      if (photoBuf) {
        doc.image(photoBuf, photoX, photoY, { fit: [photoW, photoH], align: "center", valign: "center" });
      } else {
        doc.fillColor("#64748B").fontSize(8).font("Helvetica-Bold").text(`${student.lastName.charAt(0)}${student.firstName.charAt(0)}`, photoX + 15, photoY + 24);
      }

      // Données de l'apprenant
      const infoX = 64;
      let infoY = 34;
      doc.fillColor("#64748B").fontSize(5.5).font("Helvetica-Bold").text("NOM :", infoX, infoY);
      doc.fillColor("#0F172A").fontSize(6.5).font("Helvetica-Bold").text(student.lastName.toUpperCase(), infoX + 28, infoY, { width: 145, truncate: true });

      infoY += 10;
      doc.fillColor("#64748B").fontSize(5.5).font("Helvetica-Bold").text("PRÉNOM :", infoX, infoY);
      doc.fillColor("#0F172A").fontSize(6.5).font("Helvetica-Bold").text(student.firstName, infoX + 28, infoY, { width: 145, truncate: true });

      infoY += 10;
      doc.fillColor("#64748B").fontSize(5.5).font("Helvetica-Bold").text("MATRICULE :", infoX, infoY);
      doc.fillColor(tmpl.primaryColor || "#5E72E4").fontSize(7).font("Helvetica-Bold").text(student.matricule, infoX + 28, infoY);

      infoY += 10;
      doc.fillColor("#64748B").fontSize(5.5).font("Helvetica-Bold").text("FILIÈRE :", infoX, infoY);
      doc.fillColor("#0F172A").fontSize(6).font("Helvetica").text(insc.filiereName, infoX + 28, infoY, { width: 145, truncate: true });

      infoY += 9;
      doc.fillColor("#64748B").fontSize(5.5).font("Helvetica-Bold").text("NIVEAU :", infoX, infoY);
      doc.fillColor("#0F172A").fontSize(6).font("Helvetica-Bold").text(`Niveau ${insc.niveauOrder} (${insc.programTypeCode || "DQP"})`, infoX + 28, infoY);

      infoY += 9;
      doc.fillColor("#64748B").fontSize(5.5).font("Helvetica-Bold").text("SESSION :", infoX, infoY);
      doc.fillColor("#0F172A").fontSize(6).font("Helvetica").text(insc.academicYearLabel, infoX + 28, infoY);

      // Bas de page Recto (Bandeau CECO)
      doc.rect(0, 138, 243, 15).fill("#F8FAFC");
      doc.rect(0, 138, 243, 0.5).stroke("#E2E8F0");
      doc.fillColor("#475569").fontSize(5).font("Helvetica").text(`Agrément : ${center.registrationNumber || "Enregistrement Ministériel"}`, 8, 143);
      doc.fillColor(tmpl.primaryColor || "#5E72E4").fontSize(5.5).font("Helvetica-Bold").text("CECO ID-PASS", 195, 143);

      // ==========================================
      // PAGE 2 : VERSO DU BADGE
      // ==========================================
      doc.addPage({ size: [243, 153], margins: { top: 6, bottom: 6, left: 8, right: 8 } });
      doc.rect(0, 0, 243, 153).fill("#FFFFFF");

      // Filigrane Verso
      if (tmpl.showWatermark !== false && logoBuf) {
        doc.save();
        doc.opacity(tmpl.watermarkOpacity || 0.06);
        doc.image(logoBuf, 70, 35, { width: 100, fit: [100, 100], align: "center", valign: "center" });
        doc.restore();
      }

      // Conditions d'usage
      doc.fillColor(tmpl.primaryColor || "#0B1C30").fontSize(6.5).font("Helvetica-Bold").text("CONDITIONS D'UTILISATION", 8, 8);
      doc.fillColor("#475569").fontSize(4.5).font("Helvetica").text(
        "Cette carte est strictement personnelle. Elle confère le statut d'apprenant au sein de l'établissement et doit être obligatoirement présentée lors de l'accès aux cours, ateliers et examens.",
        8, 18, { width: 227, lineGap: 1 }
      );

      doc.fillColor("#334155").fontSize(5).font("Helvetica-Bold").text(`Centre : ${center.phone || ""} • ${center.email || ""}`, 8, 38);
      doc.text(`Adresse : ${center.address || ""}, ${center.city || ""}`, 8, 46);

      // QR Code d'authentification et signature
      doc.image(qrBuf, 8, 62, { width: 44, height: 44 });
      doc.fillColor("#64748B").fontSize(4.5).font("Helvetica-Bold").text("Scan pour vérification :", 56, 64);
      doc.fillColor(tmpl.primaryColor || "#5E72E4").fontSize(4.5).font("Courier").text(snapshot.qrToken, 56, 72, { width: 175 });

      const sigBuf = bufferFromDataUrl(center.signatures?.directeur);
      if (sigBuf) {
        doc.image(sigBuf, 160, 84, { fit: [65, 24], align: "center" });
      }
      doc.fillColor("#0F172A").fontSize(5.5).font("Helvetica-Bold").text(center.directorTitle || "Le Directeur Général", 150, 112, { width: 85, align: "center" });

      // Bandeau légal et logo CECO au verso (Mention obligatoire V2)
      doc.rect(0, 134, 243, 19).fill("#0B1C30");
      doc.fillColor("#94A3B8").fontSize(4.5).font("Helvetica").text("Propriété de l'établissement. En cas de perte, merci de rapporter à la direction.", 8, 138, { width: 160 });
      doc.fillColor("#FFFFFF").fontSize(6).font("Helvetica-Bold").text("PROPULSÉ PAR CECO", 175, 140);

      doc.end();
      writeStream.on("finish", () => resolve(outputPath));
      writeStream.on("error", reject);

    } catch (err) {
      reject(err);
    }
  });
}

// 2. Génération par Lot des Cartes d'Étudiants (Format A4 avec repères de découpe pour duplex Recto / Verso)
async function generateBatchCardsSheetPdf(snapshotsList, qrUrlsList, outputPath) {
  return new Promise(async (resolve, reject) => {
    try {
      const doc = new PDFDocument({
        size: "A4",
        margins: { top: 20, bottom: 20, left: 20, right: 20 },
        autoFirstPage: true
      });

      const writeStream = fs.createWriteStream(outputPath);
      doc.pipe(writeStream);

      // Grille A4 : 2 colonnes x 4 lignes = 8 badges par feuille A4 (Dimensions badge : 255 x 165 pt)
      const cardW = 255;
      const cardH = 165;
      const startX = 35;
      const startY = 35;
      const gapX = 15;
      const gapY = 15;

      const CARDS_PER_PAGE = 8;
      const totalPages = Math.ceil(snapshotsList.length / CARDS_PER_PAGE);

      for (let p = 0; p < totalPages; p++) {
        const pageItems = snapshotsList.slice(p * CARDS_PER_PAGE, (p + 1) * CARDS_PER_PAGE);
        const pageQrUrls = qrUrlsList.slice(p * CARDS_PER_PAGE, (p + 1) * CARDS_PER_PAGE);

        if (p > 0) doc.addPage({ size: "A4", margins: { top: 20, bottom: 20, left: 20, right: 20 } });

        // ==========================================
        // PLANCHE RECTO (Page A4)
        // ==========================================
        for (let i = 0; i < pageItems.length; i++) {
          const row = Math.floor(i / 2);
          const col = i % 2;
          const x = startX + col * (cardW + gapX);
          const y = startY + row * (cardH + gapY);

          const snap = pageItems[i];
          const tmpl = snap.templateConfig || {};
          const logoBuf = bufferFromDataUrl(snap.center.logoDataUrl);
          const sealBuf = bufferFromDataUrl(snap.center.sealDataUrl);
          const photoBuf = bufferFromDataUrl(snap.student.photoDataUrl);

          // Cadre et repère de découpe
