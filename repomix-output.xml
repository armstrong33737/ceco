                  disabled={isRegenerating}
                  className="px-3 py-1.5 text-xs font-bold text-primary underline hover:opacity-80 disabled:opacity-50"
                >
                  {isRegenerating ? "Ré-émission en cours..." : "Ré-émettre le document (Forcer)"}
