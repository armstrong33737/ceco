        doc.font("Helvetica").text(row.rank ? `${row.rank}e` : "—", sx + 45, y + 3.5, { width: 30, align: "center" });

        const isPassed = row.decision === "ADMIS" || row.decision === "VALIDÉ" || row.decision === "DIPLÔMÉ";
