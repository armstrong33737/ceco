          doc.fillColor(tmpl.primaryColor || "#0B1C30").fontSize(6.5).font("Helvetica-Bold").text("CONDITIONS D'UTILISATION", x + 8, y + 8);
          doc.fillColor("#475569").fontSize(5).font("Helvetica").text(
