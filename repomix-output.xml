                  <th className="px-md py-3">Apprenant</th>
                  <th className="px-md py-3">Classe &amp; Cohorte</th>
                  <th className="px-md py-3">
                    {viewMode === "active" ? "Urgence (Tuteur)" : "Date d'Archivage"}
