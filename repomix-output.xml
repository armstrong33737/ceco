  }
  button.mode-btn:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 14px rgba(94,114,228,0.15);
    transform: translateY(-1px);
  }
  button.mode-btn .material-symbols-outlined {
    color: var(--primary);
    font-size: 22px;
    flex-shrink: 0;
  }
  button.mode-btn strong { display: block; color: var(--ink); margin-bottom: 2px; }
  .client-form { display: none; flex-direction: column; gap: 12px; margin-top: 4px; }
  .client-form.visible { display: flex; }
  label { font-size: 13px; font-weight: 500; color: var(--ink-variant); }
  input[type="text"] {
    padding: 12px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--outline);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }
  input[type="text"]:focus { border-color: var(--primary); }
  .primary-btn {
    background: linear-gradient(135deg, var(--primary), var(--violet));
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 4px 14px rgba(94,114,228,0.3);
  }
  .primary-btn:hover { box-shadow: 0 6px 18px rgba(94,114,228,0.4); }
  .back-link {
    background: none;
    border: none;
    color: var(--ink-variant);
    font-size: 13px;
    cursor: pointer;
    text-align: left;
    padding: 0;
    font-family: inherit;
  }
  .status { margin-top: 14px; font-size: 13px; min-height: 18px; border-radius: 8px; }
  .status.error { color: var(--danger); background: var(--danger-light); padding: 8px 12px; }
  .status.pending { color: var(--ink-variant); display: flex; align-items: center; gap: 6px; }
  .spin { animation: spin 0.8s linear infinite; font-size: 16px; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="card">
    <div class="icon-badge"><span class="material-symbols-outlined">school</span></div>
    <h1>Bienvenue sur CECO</h1>
    <p class="subtitle">Choisissez comment cette machine doit fonctionner.</p>

    <div class="choice" id="choiceView">
      <button class="mode-btn" id="btnServeur">
        <span class="material-symbols-outlined">dns</span>
        <span>
          <strong>Mode Serveur</strong>
          Cette machine héberge la base de données et les services CECO.
        </span>
      </button>
      <button class="mode-btn" id="btnClient">
        <span class="material-symbols-outlined">wifi</span>
        <span>
          <strong>Mode Client</strong>
          Se connecter à un serveur CECO déjà actif sur le réseau.
        </span>
      </button>
    </div>

    <div class="client-form" id="clientForm">
      <label for="serverAddress">Adresse du serveur (ex. 192.168.1.10:4000)</label>
      <input type="text" id="serverAddress" placeholder="192.168.1.10:4000" />
      <button class="primary-btn" id="btnConnect">Se connecter</button>
      <button class="back-link" id="btnBack">← Retour</button>
    </div>

    <div class="status" id="status"></div>
  </div>

  <script>
    const choiceView = document.getElementById("choiceView");
    const clientForm = document.getElementById("clientForm");
    const statusEl = document.getElementById("status");

    function setStatus(text, kind) {
      statusEl.className = "status" + (kind ? " " + kind : "");
      if (kind === "pending") {
        statusEl.innerHTML = '<span class="material-symbols-outlined spin">progress_activity</span>' + text;
      } else {
        statusEl.textContent = text || "";
      }
    }

    document.getElementById("btnServeur").addEventListener("click", async () => {
      setStatus("Démarrage des services locaux...", "pending");
      const result = await window.cecoSetup.chooseServer();
      if (!result.ok) setStatus(result.error, "error");
    });

    document.getElementById("btnClient").addEventListener("click", () => {
      choiceView.style.display = "none";
      clientForm.classList.add("visible");
    });

    document.getElementById("btnBack").addEventListener("click", () => {
      choiceView.style.display = "flex";
      clientForm.classList.remove("visible");
      setStatus("");
    });

    document.getElementById("btnConnect").addEventListener("click", async () => {
      const address = document.getElementById("serverAddress").value.trim();
      if (!address) return setStatus("Veuillez saisir une adresse.", "error");
      setStatus("Connexion en cours...", "pending");
      const result = await window.cecoSetup.chooseClient(address);
      if (!result.ok) setStatus(result.error, "error");
    });
  </script>
</body>
</html>
