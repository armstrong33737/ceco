                      <td className="px-3 py-2 text-center font-mono font-bold text-primary bg-surface/50">{calc.ccAvg}</td>

                      {/* Examen Normale */}
                      <td className="px-2 py-1.5 text-center">
                        <div className="flex items-center justify-center gap-1">
                          <input
