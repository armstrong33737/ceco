      doc.rect(startX, y, fullWidth, 13).strokeColor("#CBD5E1").stroke();
      doc.fillColor("#0F172A").fontSize(6).font("Helvetica");
      doc.text(`${sub.code ? `[${sub.code}] ` : ""}${sub.name}`, startX + 4, y + 3.5, { width: colModW2 - 4, truncate: true });
