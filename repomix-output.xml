  center       Center     @relation(fields: [centerId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  startDate    DateTime
  endDate      DateTime
