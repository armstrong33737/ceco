                  <Icon name="progress_activity" className="animate-spin text-[18px]" />
                  <span>Connexion en cours...</span>
                </>
              ) : (
                <>
                  <span>Se connecter</span>
                  <Icon name="arrow_forward" className="text-[18px]" />
                </>
              )}
