  }
  button.mode-btn strong { display: block; color: var(--ink); font-size: 14px; margin-bottom: 2px; }
  button.mode-btn span.desc { color: var(--ink-variant); font-size: 12px; line-height: 1.3; }

  .client-view { display: none; flex-direction: column; gap: 12px; }
  .client-view.visible { display: flex; }

  .discovery-panel {
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .discovery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
  }
  .scan-btn {
    background: none;
    border: none;
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    padding: 2px 4px;
  }
  .scan-btn:hover { text-decoration: underline; }
  
  .server-list {
    max-height: 110px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .server-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: white;
    border: 1px solid var(--outline);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 12px;
  }
  .server-item:hover { border-color: var(--primary); }
  .server-name { font-weight: 600; color: var(--ink); }
  .server-ip { font-size: 11px; color: var(--ink-variant); }
  
  .connect-server-btn {
    background: var(--primary);
    color: white;
    border: none;
