<body>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="card">
    <div class="header-logo">
      <img src="../../assets/icon.png" alt="Logo CECO" class="logo-img" onerror="this.style.display='none'" />
      <div>
        <h1>Bienvenue sur CECO</h1>
        <p class="subtitle">Choisissez le mode d'exécution de cette machine.</p>
      </div>
    </div>

    <!-- Vue principale de sélection -->
    <div class="choice" id="choiceView">
      <button class="mode-btn" id="btnServeur">
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M4 1h16c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2zm0 8h16c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2v-4c0-1.1.9-2 2-2zm0 8h16c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2v-4c0-1.1.9-2 2-2zM6 5h2v2H6V5zm0 8h2v2H6v-2zm0 8h2v2H6v-2z"/></svg>
        </div>
        <div>
          <strong>Mode Serveur</strong>
          <span class="desc">Héberge la base de données locale et les services du centre.</span>
        </div>
      </button>

      <button class="mode-btn" id="btnClient">
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98A16.88 16.88 0 0 0 12 4zm0 3.5c3.55 0 6.81 1.34 9.3 3.56L12 18.25 2.7 11.06A14.28 14.28 0 0 1 12 7.5z"/></svg>
        </div>
        <div>
          <strong>Mode Client</strong>
          <span class="desc">Se connecte à un serveur CECO actif sur le réseau local.</span>
        </div>
      </button>
    </div>

    <!-- Vue de configuration client avec découverte réseau -->
    <div class="client-view" id="clientView">
      <div class="discovery-panel">
        <div class="discovery-header">
          <span>Serveurs détectés sur le réseau</span>
          <button class="scan-btn" id="btnRescan">Actualiser</button>
        </div>
        <div class="server-list" id="serverList">
          <div style="font-size: 11px; color: var(--ink-variant); text-align: center; padding: 12px 0;" id="discoveryStatus">
            Recherche en cours...
          </div>
        </div>
      </div>

      <div class="divider"><span>ou saisie manuelle</span></div>

      <div style="display: flex; flex-direction: column; gap: 6px;">
        <label for="serverAddress">Adresse IP et port du serveur</label>
        <input type="text" id="serverAddress" placeholder="Ex: 192.168.1.50:4000" />
      </div>

      <button class="primary-btn" id="btnConnectManual">Se connecter</button>
      <button class="back-link" id="btnBack">← Revenir au choix de mode</button>
    </div>

    <div class="status" id="status"></div>
  </div>

  <script>
    const choiceView = document.getElementById("choiceView");
    const clientView = document.getElementById("clientView");
    const statusEl = document.getElementById("status");
    const serverListEl = document.getElementById("serverList");
    const serverAddressInput = document.getElementById("serverAddress");

    function setStatus(text, kind) {
      statusEl.className = "status" + (kind ? " " + kind : "");
      if (kind === "pending") {
        statusEl.innerHTML = '<span class="spinner"></span> ' + text;
      } else {
        statusEl.textContent = text || "";
      }
    }

    document.getElementById("btnServeur").addEventListener("click", async () => {
      setStatus("Démarrage de PostgreSQL et des services...", "pending");
      const result = await window.cecoSetup.chooseServer();
      if (!result.ok) setStatus(result.error, "error");
    });

    document.getElementById("btnClient").addEventListener("click", () => {
      choiceView.style.display = "none";
      clientView.classList.add("visible");
      setStatus("");
      startDiscovery();
    });

    document.getElementById("btnBack").addEventListener("click", () => {
      choiceView.style.display = "flex";
      clientView.classList.remove("visible");
      setStatus("");
    });

    async function startDiscovery() {
      serverListEl.innerHTML = '<div style="font-size: 11px; color: var(--ink-variant); text-align: center; padding: 12px 0;"><span class="spinner"></span> Scan du réseau local...</div>';
      try {
        const servers = await window.cecoSetup.discoverServers();
        if (!servers || servers.length === 0) {
          serverListEl.innerHTML = '<div style="font-size: 11px; color: var(--ink-variant); text-align: center; padding: 10px 0;">Aucun serveur CECO détecté automatiquement.</div>';
          return;
        }

        serverListEl.innerHTML = "";
        servers.forEach((srv) => {
          const item = document.createElement("div");
          item.className = "server-item";
          item.innerHTML = `
            <div>
              <div class="server-name">${srv.name || "Serveur CECO"}</div>
              <div class="server-ip">${srv.address}</div>
            </div>
            <button class="connect-server-btn" data-address="${srv.address}">Choisir</button>
          `;
          serverListEl.appendChild(item);
        });

        document.querySelectorAll(".connect-server-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const addr = e.target.getAttribute("data-address");
            connectToAddress(addr);
          });
        });
      } catch (err) {
        serverListEl.innerHTML = '<div style="font-size: 11px; color: var(--danger); text-align: center; padding: 8px 0;">Échec de la détection réseau.</div>';
      }
    }

    document.getElementById("btnRescan").addEventListener("click", startDiscovery);

    async function connectToAddress(address) {
      if (!address) return setStatus("Veuillez saisir une adresse valide.", "error");
      setStatus("Connexion au serveur en cours...", "pending");
      const result = await window.cecoSetup.chooseClient(address);
      if (!result.ok) setStatus(result.error, "error");
    }

    document.getElementById("btnConnectManual").addEventListener("click", () => {
      const address = serverAddressInput.value.trim();
      connectToAddress(address);
    });
  </script>
</body>
</html>
</file>

