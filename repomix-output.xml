<file path=".github/workflows/build-desktop.yml">
name: Build & Release CECO Desktop

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - name: Récupérer le code source
        uses: actions/checkout@v4

      - name: Configurer pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9

      - name: Configurer Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: "pnpm"

      - name: Installer les dépendances
        run: pnpm install --frozen-lockfile

      - name: Générer le client Prisma
        run: pnpm --filter @ceco/backend prisma:generate

      - name: Construire l'application pour ${{ matrix.os }}
        env:
          USE_HARD_LINKS: "false"
        run: pnpm --filter @ceco/desktop run build:installer

      - name: Publier les installateurs dans la Release GitHub
        uses: softprops/action-gh-release@v2
        if: startsWith(github.ref, 'refs/tags/') || github.event_name == 'workflow_dispatch'
        with:
          tag_name: ${{ github.ref_name }}
          name: Release ${{ github.ref_name }}
          draft: false
          prerelease: false
          generate_release_notes: true
          files: |
            packages/desktop/dist/*.exe
            packages/desktop/dist/*.dmg
            packages/desktop/dist/*.deb
            packages/desktop/dist/*.snap
            packages/desktop/dist/*.AppImage
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
</file>

<file path="packages/backend/prisma/schema.prisma">
// packages/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Tenant racine ----------------

model Center {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  logo               String?
  email              String?
  phone              String?

  address            String?
  city               String?
  postalCode         String?
  country            String?
  website            String?
  registrationNumber String?
  directorName       String?
  directorTitle      String?
  description        String?

  subscriptionPlan   String   @default("local")
  maxStorage         BigInt?
  storageUsedBytes   BigInt   @default(0)
  storageCheckedAt   DateTime?
  createdAt          DateTime @default(now())

  users              User[]
  roles              Role[]
  settings           Setting[]
  subscription       Subscription?
  license            License?

  programTypes       ProgramType[]
  filieres           Filiere[]
  filiereSubjects    FiliereSubject[]
  subjectCategories  SubjectCategory[]
  promotions         Promotion[]
  classes            Classe[]
  salles             Salle[]
  academicYears      AcademicYear[]
  subjects           Subject[]
  students           Student[]
  formateurs         Formateur[]
  inscriptions       Inscription[]
  gradingPolicies    GradingPolicy[]
  gradePeriods       GradePeriod[]
  grades             Grade[]
  subjectResults     SubjectResult[]
  deliberations      Deliberation[]
  presences          Presence[]

  entreprises        Entreprise[]
  stages             Stage[]

  documentTemplates  DocumentTemplate[]
  documents          Document[]

  auditLogs          AuditLog[]
  notifications      Notification[]
}

model Subscription {
  id         String    @id @default(cuid())
  centerId   String    @unique
  center     Center    @relation(fields: [centerId], references: [id])
  plan       String    @default("local")
  status     String    @default("active")
  expiresAt  DateTime?
  maxUsers   Int?
  maxStorage BigInt?
}

model License {
  id            String   @id @default(cuid())
  centerId      String   @unique
  center        Center   @relation(fields: [centerId], references: [id])
  signedPayload String
  publicKeyId   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

model Setting {
  id       String @id @default(cuid())
  centerId String
  center   Center @relation(fields: [centerId], references: [id])
  key      String
  value    Json

  @@unique([centerId, key])
}

// ---------------- Utilisateurs & RBAC ----------------

model User {
  id        String    @id @default(cuid())
  centerId  String
  center    Center    @relation(fields: [centerId], references: [id])
  roleId    String?
  role      Role?     @relation(fields: [roleId], references: [id])
  email     String
  password  String
  firstName String
  lastName  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  formateur Formateur?

  @@unique([centerId, email])
}

model Role {
  id          String       @id @default(cuid())
  centerId    String
  center      Center       @relation(fields: [centerId], references: [id])
  name        String
  isSystem    Boolean      @default(false)
  users       User[]
  permissions Permission[]

  @@unique([centerId, name])
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  action String

  @@unique([roleId, action])
}

// ---------------- Structure académique V2 ----------------

model ProgramType {
  id       String    @id @default(cuid())
  centerId String
  center   Center    @relation(fields: [centerId], references: [id])
  code     String    // "DQP", "CQP"
  label    String
  filieres Filiere[]

  @@unique([centerId, code])
}

model Filiere {
  id              String           @id @default(cuid())
  centerId        String
  center          Center           @relation(fields: [centerId], references: [id])
  programTypeId   String
  programType     ProgramType      @relation(fields: [programTypeId], references: [id])
  name            String
  durationInYears Int
  niveaux         Niveau[]
  promotions      Promotion[]
  classes         Classe[]
  subjects        FiliereSubject[]
  gradingPolicies GradingPolicy[]
}

model Niveau {
  id        String    @id @default(cuid())
  filiereId String
  filiere   Filiere   @relation(fields: [filiereId], references: [id])
  order     Int       // 1, 2, 3
  classes   Classe[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  label     String   // "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  status    String   @default("UPCOMING") // "UPCOMING" | "CURRENT" | "CLOSED"

  promotions   Promotion[]
  classes      Classe[]
  inscriptions Inscription[]
  gradePeriods GradePeriod[]

  @@unique([centerId, label])
}

model Promotion {
  id              String       @id @default(cuid())
  centerId        String
  center          Center       @relation(fields: [centerId], references: [id])
  filiereId       String
  filiere         Filiere      @relation(fields: [filiereId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  label           String
  expectedEndYear String?
  createdAt       DateTime     @default(now())

  inscriptions    Inscription[]

  @@unique([centerId, filiereId, academicYearId])
}

model Salle {
  id       String   @id @default(cuid())
  centerId String
  center   Center   @relation(fields: [centerId], references: [id])
  name     String
  capacity Int?
  classes  Classe[]
}

model Classe {
  id             String       @id @default(cuid())
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id])
  filiereId      String
  filiere        Filiere      @relation(fields: [filiereId], references: [id])
  niveauId       String
  niveau         Niveau       @relation(fields: [niveauId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  salleId        String?
  salle          Salle?       @relation(fields: [salleId], references: [id])
  label          String

  inscriptions     Inscription[]
  subjectOfferings SubjectOffering[]
  deliberations    Deliberation[]
  presences        Presence[]

  @@unique([filiereId, niveauId, academicYearId])
}

model Student {
  id             String    @id @default(cuid())
  centerId       String
  center         Center    @relation(fields: [centerId], references: [id])
  matricule      String
  firstName      String
  lastName       String
  gender         String?   // "M" | "F"
  birthDate      DateTime?
  birthPlace     String?
  phone          String?
  guardianName   String?
  guardianPhone  String?
  entryDiploma   String?
  photoPath      String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  inscriptions   Inscription[]
  grades         Grade[]
  subjectResults SubjectResult[]
  presences      Presence[]
  stages         Stage[]
  deliberations  StudentDeliberation[]

  @@unique([centerId, matricule])
}

model Inscription {
  id             String        @id @default(cuid())
  centerId       String
  center         Center        @relation(fields: [centerId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  classeId       String
  classe         Classe        @relation(fields: [classeId], references: [id])
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  promotionId    String?
  promotion      Promotion?    @relation(fields: [promotionId], references: [id])
  status         String        @default("en_cours") // en_cours | admis | redouble | abandon | diplome
  createdAt      DateTime      @default(now())

  @@unique([studentId, academicYearId])
}

// ---------------- PÉDAGOGIE V3 (Matières, Catégories Libres, Formateurs) ----------------

// Catégories / Groupes d'enseignement 100% dynamiques définis par l'établissement
model SubjectCategory {
  id              String           @id @default(cuid())
  centerId        String
  center          Center           @relation(fields: [centerId], references: [id])
  name            String           // Nom libre : "Matières Scientifiques", "Matières Professionnelles", etc.
  code            String?          // Code court facultatif : "SCI", "PRO", "GEN"
  order           Int              @default(1) // Ordre d'apparition sur les relevés / diplômes
  isEliminatory   Boolean          @default(false) // Option : note éliminatoire si sous le seuil
  createdAt       DateTime         @default(now())

  filiereSubjects FiliereSubject[]
  offerings       SubjectOffering[]

  @@unique([centerId, name])
}

// Référentiel neutre et universel des matières (sans catégorie en dur)
model Subject {
  id               String           @id @default(cuid())
  centerId         String
  center           Center           @relation(fields: [centerId], references: [id])
  name             String           // "Thermodynamique", "Informatique", "Dessin Technique"
  code             String?          // "THM101", "INF102"
  createdAt        DateTime         @default(now())

  filiereTemplates FiliereSubject[]
  offerings        SubjectOffering[]
  subjectResults   SubjectResult[]

  @@unique([centerId, code])
}

// Maquette type permanente par filière & niveau (Gabarit réutilisable d'une année sur l'autre)
model FiliereSubject {
  id                   String           @id @default(cuid())
  centerId             String
  center               Center           @relation(fields: [centerId], references: [id])
  filiereId            String
  filiere              Filiere          @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  niveauOrder          Int              // Niveau 1, 2 ou 3
  semesterOrder        Int              // Semestre 1 ou 2
  subjectId            String
  subject              Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  categoryId           String?          // Liaison contextuelle à une catégorie de l'établissement
  category             SubjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  defaultCoefficient   Float            @default(2.0)
  defaultVolumeHoraire Int?

  @@unique([filiereId, niveauOrder, semesterOrder, subjectId])
}

// Formateurs / Enseignants
model Formateur {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  firstName   String
  lastName    String
  email       String?
  phone       String?
  specialite  String?  // ex: "Génie Mécanique / Froid"
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  offerings   SubjectOffering[]
}

// Instance Annuelle de Matière dans une Classe (Générée depuis la maquette ou ajoutée en cours d'année)
model SubjectOffering {
  id            String           @id @default(cuid())
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id])
  classeId      String
  classe        Classe           @relation(fields: [classeId], references: [id], onDelete: Cascade)
  gradePeriodId String           // Semestre 1 ou Semestre 2
  gradePeriod   GradePeriod      @relation(fields: [gradePeriodId], references: [id])
  categoryId    String?          // Catégorie contextuelle pour cette classe
  category      SubjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  formateurId   String?          // Multi-affectation libre (le formateur peut avoir plusieurs cours)
  formateur     Formateur?       @relation(fields: [formateurId], references: [id], onDelete: SetNull)

  coefficient   Float            @default(2.0)
  volumeHoraire Int?
  isActive      Boolean          @default(true)

  grades        Grade[]

  @@unique([subjectId, classeId, gradePeriodId])
}

// Politique de Pondération CC_TP vs NORMALE (30/70, 40/60...)
model GradingPolicy {
  id            String    @id @default(cuid())
  centerId      String
  center        Center    @relation(fields: [centerId], references: [id])
  filiereId     String?   // null = politique globale de l'établissement
  filiere       Filiere?  @relation(fields: [filiereId], references: [id])
  ccWeight      Float     @default(0.30)
  normalWeight  Float     @default(0.70)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([centerId, filiereId, effectiveFrom])
}

model GradePeriod {
  id             String       @id @default(cuid())
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  type           String       // "SEMESTRE" | "ANNUEL"
  order          Int          // 1, 2 pour semestre ; 1 pour annuel
  label          String       // "Semestre 1", "Semestre 2"
  startDate      DateTime
  endDate        DateTime

  subjectOfferings SubjectOffering[]
  grades           Grade[]
  subjectResults   SubjectResult[]
  deliberations    Deliberation[]

  @@unique([centerId, academicYearId, type, order])
}

// Notes brutes individuelles saisies (avec prise en compte des absences)
model Grade {
  id                String          @id @default(cuid())
  centerId          String
  center            Center          @relation(fields: [centerId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  subjectOfferingId String
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id])
  gradePeriodId     String
  gradePeriod       GradePeriod     @relation(fields: [gradePeriodId], references: [id])
  
  evaluationType    String          // "CC_TP" | "NORMALE" | "RATTRAPAGE"
  label             String?         // "CC1", "CC2", "TP1", "Examen Final", "Rattrapage"
  value             Float           // Note sur 20
  maxValue          Float           @default(20)
  isAbsent          Boolean         @default(false)
  absenceReason     String?         // "JUSTIFIED" | "UNJUSTIFIED" | null
  createdAt         DateTime        @default(now())
}

// Synthèse figée par matière pour le relevé/bulletin (Rétroactivité Zéro)
model SubjectResult {
  id              String      @id @default(cuid())
  centerId        String
  center          Center      @relation(fields: [centerId], references: [id])
  studentId       String
  student         Student     @relation(fields: [studentId], references: [id])
  subjectId       String
  subject         Subject     @relation(fields: [subjectId], references: [id])
  gradePeriodId   String      // Semestre 1, Semestre 2 ou Annuel
  gradePeriod     GradePeriod @relation(fields: [gradePeriodId], references: [id])

  computationMode String      // "CC_NORMALE" | "AGGREGATE_SEMESTRES"
  ccAverage       Float?      // Moyenne arithmétique des CC_TP
  normalAverage   Float?      // Note examen (ou retenue avec rattrapage)
  ccWeight        Float       // ex: 0.30
  normalWeight    Float       // ex: 0.70
  gradingPolicyId String?
  coefficient     Float
  finalGrade      Float       // Note finale calculée (/20)
  isLocked        Boolean     @default(false)
  computedAt      DateTime    @default(now())

  @@unique([studentId, subjectId, gradePeriodId])
}

model Deliberation {
  id            String      @id @default(cuid())
  centerId      String
  center        Center      @relation(fields: [centerId], references: [id])
  classeId      String
  classe        Classe      @relation(fields: [classeId], references: [id])
  gradePeriodId String
  gradePeriod   GradePeriod @relation(fields: [gradePeriodId], references: [id])
  scope         String      // "CC" | "NORMALE" | "SEMESTRE" | "ANNUEL"
  juryDate      DateTime

  studentResults StudentDeliberation[]

  @@unique([classeId, gradePeriodId, scope])
}

model StudentDeliberation {
  id             String       @id @default(cuid())
  deliberationId String
  deliberation   Deliberation @relation(fields: [deliberationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  moyenne        Float
  rang           Int
  decision       String
}

model Presence {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classeId  String
  classe    Classe   @relation(fields: [classeId], references: [id])
  date      DateTime
  present   Boolean  @default(true)
}

model Entreprise {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  name     String
  contact  String?
  stages   Stage[]
}

model Stage {
  id           String     @id @default(cuid())
  centerId     String
  center       Center     @relation(fields: [centerId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  startDate    DateTime
  endDate      DateTime
  evaluation   Float?
}

model DocumentTemplate {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  type     String
  config   Json
  isActive Boolean @default(true)

  @@unique([centerId, type])
}

model Document {
  id             String   @id @default(cuid())
  centerId       String
  center         Center   @relation(fields: [centerId], references: [id])
  type           String
  studentId      String?
  classeId       String?
  filePath       String
  fileHash       String
  renderSnapshot Json
  qrToken        String   @unique
  generatedAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String?
  channel   String   @default("internal")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
</file>

<file path="packages/backend/src/routes/backups.js">
// packages/backend/src/routes/backups.js
const express = require("express");
const fs = require("fs");
const path = require("path");
const archiver = require("archiver");
const extract = require("extract-zip");
const prisma = require("../prismaClient");
const { verifyJwt } = require("../middleware/auth");
const { requirePermission } = require("../middleware/permissions");
const { centerStoragePath, ensureStorageTree } = require("../storage/paths");

const router = express.Router();

function backupDir(centerId) {
  return centerStoragePath(centerId, "backups");
}

function copyFolderRecursiveSync(from, to) {
  if (!fs.existsSync(to)) fs.mkdirSync(to, { recursive: true });
  const elements = fs.readdirSync(from);
  for (const element of elements) {
    const fromPath = path.join(from, element);
    const toPath = path.join(to, element);
    if (fs.lstatSync(fromPath).isDirectory()) {
      copyFolderRecursiveSync(fromPath, toPath);
    } else {
      fs.copyFileSync(fromPath, toPath);
    }
  }
}

// 1. Liste des sauvegardes existantes
router.get("/backups", verifyJwt, requirePermission("backups.read"), async (req, res, next) => {
  try {
    const dir = backupDir(req.centerId);
    await ensureStorageTree(req.centerId);
    const files = fs.readdirSync(dir);

    const backupFiles = files
      .filter((file) => file.endsWith(".zip"))
      .map((file) => {
        const filePath = path.join(dir, file);
        const stats = fs.statSync(filePath);
        return { name: file, sizeBytes: stats.size, createdAt: stats.mtime };
      })
      .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());

    res.json(backupFiles);
  } catch (err) {
    next(err);
  }
});

// 2. Configuration automatique
router.get("/backups/config", verifyJwt, requirePermission("backups.read"), async (req, res, next) => {
  try {
    const setting = await prisma.setting.findUnique({
      where: { centerId_key: { centerId: req.centerId, key: "backup.config" } },
    });
    res.json(setting?.value || { frequency: "daily" });
  } catch (err) {
    next(err);
  }
});

router.put("/backups/config", verifyJwt, requirePermission("backups.update"), async (req, res, next) => {
  try {
