}

// ---------------- Documents (moteur générique) ----------------

model DocumentTemplate {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  type     String  // BULLETIN | PV | PRESENCE | ATTESTATION | DIPLOME | CONVENTION | RECU ...
  config   Json    // logo, en-tête, pied de page, blocs de signature, couleurs
