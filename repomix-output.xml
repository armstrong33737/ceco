      doc.moveTo(25, 50).lineTo(815, 50).lineWidth(1).strokeColor(primaryColor).stroke();

      let y = 58;
      const colMatriculeW = 65;
      const colNameW = 140;
      const colSummaryW = 120;
      const availWidth = 790 - (colMatriculeW + colNameW + colSummaryW);
