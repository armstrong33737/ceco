          // Pied Recto
          doc.rect(x, y + 148, cardW, 17).fill("#F8FAFC");
          doc.fillColor("#64748B").fontSize(5).font("Helvetica").text(`Session : ${snap.inscription.academicYearLabel}`, x + 8, y + 153);
          doc.fillColor(tmpl.primaryColor || "#5E72E4").fontSize(6).font("Helvetica-Bold").text("CECO ID-PASS", x + 195, y + 153);
        }

        // ==========================================
        // PLANCHE VERSO (Page A4 assortie pour impression recto/verso)
        // ==========================================
        doc.addPage({ size: "A4", margins: { top: 20, bottom: 20, left: 20, right: 20 } });

        for (let i = 0; i < pageItems.length; i++) {
          const row = Math.floor(i / 2);
          // Inversion de colonne pour alignement exact lors du retournement de la feuille
          const col = 1 - (i % 2);
          const x = startX + col * (cardW + gapX);
          const y = startY + row * (cardH + gapY);

          const snap = pageItems[i];
          const qrUrl = pageQrUrls[i];
          const qrBuf = await QRCode.toBuffer(qrUrl, { margin: 0, width: 80 });
          const tmpl = snap.templateConfig || {};

