        filePath: fullPath,
        fileHash: crypto.createHash("sha256").update(fs.readFileSync(fullPath)).digest("hex"),
        renderSnapshot: snapshot,
        generatedAt: new Date(),
      },
      create: {
        centerId: req.centerId,
        type: "BORDEREAU_VIERGE",
        classeId: offering.classeId,
        filePath: fullPath,
