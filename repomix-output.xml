      doc.text(`Groupe : ${offering.categoryName || "Général"}`, 40, 156);
      doc.text(`Formateur : ${offering.formateurName || "Non assigné"}`, 220, 156);
      doc.text(`Taux de réussite : ${stats.successRate || "0"}%`, 420, 156);

      // Tableau des notes
