                  <div className="relative z-10 -mx-3.5 -mt-3.5 px-3.5 py-2.5 flex items-center justify-between text-white" style={{ backgroundColor: config.themeColor || "#004080" }}>
                    <div className="flex items-center gap-2 max-w-[250px]">
