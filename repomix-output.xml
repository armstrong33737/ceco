                <button
                  type="button"
                  onClick={() => setCardPreviewSide("verso")}
                  className={`px-3 py-1 text-caption font-semibold rounded-[2px] ${cardPreviewSide === "verso" ? "bg-brand-900 text-white dark:bg-brand-500" : "text-ink-secondary"}`}
                >
                  Dos Verso
                </button>
