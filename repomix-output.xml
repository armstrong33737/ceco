            x + 8, y + 18, { width: 235, lineGap: 1 }
          );

          doc.image(qrBuf, x + 8, y + 54, { width: 44, height: 44 });
          doc.fillColor("#64748B").fontSize(5).font("Helvetica-Bold").text("Authentification :", x + 58, y + 56);
          doc.fillColor(tmpl.primaryColor || "#5E72E4").fontSize(5).font("Courier").text(snap.qrToken, x + 58, y + 64, { width: 185 });

          const sigBuf = bufferFromDataUrl(snap.center.signatures?.directeur);
          if (sigBuf) doc.image(sigBuf, x + 165, y + 80, { fit: [70, 24], align: "center" });
          doc.fillColor("#0F172A").fontSize(5.5).font("Helvetica-Bold").text(snap.center.directorTitle || "Le Directeur Général", x + 160, y + 106, { width: 85, align: "center" });

          // Bandeau verso CECO
          doc.rect(x, y + 146, cardW, 19).fill("#0B1C30");
          doc.fillColor("#94A3B8").fontSize(4.5).font("Helvetica").text(`Agrément : ${snap.center.registrationNumber || "MINEFOP"}`, x + 8, y + 151);
          doc.fillColor("#FFFFFF").fontSize(6).font("Helvetica-Bold").text("PROPULSÉ PAR CECO", x + 185, y + 151);
        }
      }

      doc.end();
      writeStream.on("finish", () => resolve(outputPath));
      writeStream.on("error", reject);

    } catch (err) {
      reject(err);
    }
  });
}

// 3. Génération du Certificat de Scolarité / Attestation A4 (Norme Bilingue Officielle)
async function generateAttestationPdf(snapshot, qrUrl, outputPath) {
