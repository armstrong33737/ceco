        35, 128, { width: 525, align: "center" }
      );

      doc.moveTo(35, 142).lineTo(560, 142).lineWidth(1.5).strokeColor(tmpl.primaryColor || "#0B1C30").stroke();

      // TITRE DU DOCUMENT
      doc.moveDown(2);
      doc.fillColor("#0F172A").fontSize(13).font("Helvetica-Bold").text("CERTIFICAT DE SCOLARITÉ & D'INSCRIPTION", 35, 165, { width: 525, align: "center", underline: true });
      doc.fillColor("#64748B").fontSize(8).font("Helvetica-Bold").text("ATTESTATION OF ENROLMENT", 35, 182, { width: 525, align: "center" });

      // CORPS DU TEXTE
