        <div class="row"><span class="label">Décision du Jury :</span><span class="val" style="color:#16805A;text-transform:uppercase;font-weight:bold;">${snap.totals?.decision || "—"}</span></div>
      `;
    } else if (doc.type === "DIPLOME_FIN_FORMATION") {
      detailsHtml = `
