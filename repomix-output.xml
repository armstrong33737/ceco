                  <button onClick={() => setDeleteTarget({ endpoint: "salles", id: s.id, name: s.name })} className="text-error hover:bg-error-container/20 p-1.5 rounded-md">
                    <Icon name="delete" className="text-[16px]" />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
