{
  "name": "@ceco/desktop",
  "version": "0.0.1-v0",
  "private": true,
  "main": "src/main.js",
  "description": "CECO - client desktop Electron",
  "author": "CECO",
  "scripts": {
    "dev": "electron .",
    "build:installer": "pnpm --filter @ceco/backend run prisma:generate && pnpm --filter @ceco/backend run build:bundle && pnpm --filter @ceco/frontend run build && node -e \"const fs=require('fs'); if(fs.existsSync('node_modules')) fs.rmSync('node_modules', {recursive:true,force:true})\" && npm install --production --no-package-lock && electron-builder --publish never"
  },
  "build": {
    "appId": "africa.ceco.desktop",
    "productName": "CECO",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/embedded-postgres/**/*",
      "node_modules/@embedded-postgres/**/*"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma",
        "filter": ["schema.prisma", "migrations/**/*"]
      },
      {
        "from": "../backend/dist/server.bundle.js",
        "to": "backend/server.bundle.js"
      },
      {
        "from": "../backend/dist/seed.bundle.js",
        "to": "backend/seed.bundle.js"
      },
      {
        "from": "../../node_modules/@prisma/client",
        "to": "backend/node_modules/@prisma/client"
      },
      {
        "from": "../../node_modules/.prisma",
        "to": "backend/node_modules/.prisma"
      }
    ],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.22.0",
    "prisma": "5.20.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  }
}