{
  "name": "@ceco/desktop",
  "version": "0.0.1-v0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:installer": "electron-builder --publish never"
  },
  "build": {
    "appId": "africa.ceco.desktop",
    "productName": "CECO",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}