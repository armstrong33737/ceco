{
  "name": "@ceco/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.js",
  "description": "CECO — Suite ERP de gestion des centres de formation professionnelle",
  "author": {
    "name": "Armstrong Euclador NGALEU",
    "email": "armstrongngaleu3@gmail.com",
    "url": "https://armstrongngaleu.netlify.app"
  },
  "homepage": "https://armstrongngaleu.netlify.app",
  "copyright": "Copyright © 2026 Armstrong Euclador NGALEU. Tous droits réservés.",
  "scripts": {
    "dev": "electron .",
    "build:installer": "pnpm --filter @ceco/backend run prisma:generate && pnpm --filter @ceco/backend run build:bundle && pnpm --filter @ceco/frontend run build && electron-builder --publish never"
  },
  "build": {
    "appId": "cm.ceco.suite.erp",
    "productName": "CECO Suite ERP",
    "copyright": "Copyright © 2026 Armstrong Euclador NGALEU. Tous droits réservés.",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "assets/**/*",
      "node_modules/embedded-postgres/**/*",
      "node_modules/@embedded-postgres/**/*",
      "node_modules/prisma/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/pdfkit/**/*",
      "node_modules/qrcode/**/*"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "assets/**/*",
      "!**/keys/private.key",
      "!**/scripts/**",
      "!**/.env*",
      "!**/*.log",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "schema.prisma",
          "migrations/**/*"
        ]
      },
      {
        "from": "../backend/dist/server.bundle.js",
        "to": "backend/server.bundle.js"
      },
      {
        "from": "../backend/dist/seed.bundle.js",
        "to": "backend/seed.bundle.js"
      },
      {
        "from": "../../node_modules/@prisma/client",
        "to": "backend/node_modules/@prisma/client"
      },
      {
        "from": "../../node_modules/.prisma",
        "to": "backend/node_modules/.prisma"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "legalTrademarks": "CECO — Armstrong Euclador NGALEU"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CECO Suite ERP",
      "license": "assets/license_fr.txt",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": true
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "synopsis": "ERP de gestion des centres de formation professionnelle",
      "description": "Solution complète pour la gestion pédagogique, administrative et financière des centres de formation.",
      "desktop": {
        "StartupWMClass": "CECO Suite ERP"
      }
    }
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "prisma": "5.20.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  }
}