{
  "name": "@ceco/backend",
  "version": "0.0.1-v0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "build:bundle": "esbuild src/index.js --bundle --platform=node --target=node20 --outfile=dist/server.bundle.js --external:@prisma/client && esbuild prisma/seed.js --bundle --platform=node --target=node20 --outfile=dist/seed.bundle.js --external:@prisma/client"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "2.4.3",
    "zod": "^3.23.8",
    "cors": "^2.8.5",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "prisma": "5.20.0",
    "esbuild": "0.23.1"
  }
}