// packages/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Tenant racine ----------------

model Center {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  logo               String?
  email              String?
  phone              String?

  address            String?
  city               String?
  postalCode         String?
  country            String?
  website            String?
  registrationNumber String?
  directorName       String?
  directorTitle      String?
  description        String?

  subscriptionPlan   String   @default("local")
  maxStorage         BigInt?
  storageUsedBytes   BigInt   @default(0)
  storageCheckedAt   DateTime?
  createdAt          DateTime @default(now())

  users              User[]
  roles              Role[]
  settings           Setting[]
  subscription       Subscription?
  license            License?

  programTypes       ProgramType[]
  filieres           Filiere[]
  filiereSubjects    FiliereSubject[]
  subjectCategories  SubjectCategory[]
  promotions         Promotion[]
  classes            Classe[]
  salles             Salle[]
  academicYears      AcademicYear[]
  subjects           Subject[]
  students           Student[]
  formateurs         Formateur[]
  inscriptions       Inscription[]
  gradingPolicies    GradingPolicy[]
  gradePeriods       GradePeriod[]
  grades             Grade[]
  subjectResults     SubjectResult[]
  deliberations      Deliberation[]
  presences          Presence[]

  entreprises        Entreprise[]
  stages             Stage[]

  documentTemplates  DocumentTemplate[]
  documents          Document[]

  // Miroir Examens Blancs
  mockSubjects       MockSubject[]
  filiereMockSubjects FiliereMockSubject[]
  mockExamSessions   MockExamSession[]
  classeMockExams    ClasseMockExam[]

  auditLogs          AuditLog[]
  notifications      Notification[]
}

model Subscription {
  id         String    @id @default(cuid())
  centerId   String    @unique
  center     Center    @relation(fields: [centerId], references: [id])
  plan       String    @default("local")
  status     String    @default("active")
  expiresAt  DateTime?
  maxUsers   Int?
  maxStorage BigInt?
}

model License {
  id            String   @id @default(cuid())
  centerId      String   @unique
  center        Center   @relation(fields: [centerId], references: [id])
  signedPayload String
  publicKeyId   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

model Setting {
  id       String @id @default(cuid())
  centerId String
  center   Center @relation(fields: [centerId], references: [id])
  key      String
  value    Json

  @@unique([centerId, key])
}

// ---------------- Utilisateurs & RBAC ----------------

model User {
  id        String    @id @default(cuid())
  centerId  String
  center    Center    @relation(fields: [centerId], references: [id])
  roleId    String?
  role      Role?     @relation(fields: [roleId], references: [id])
  email     String
  password  String
  firstName String
  lastName  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  formateur Formateur?

  @@unique([centerId, email])
}

model Role {
  id          String       @id @default(cuid())
  centerId    String
  center      Center       @relation(fields: [centerId], references: [id])
  name        String
  isSystem    Boolean      @default(false)
  users       User[]
  permissions Permission[]

  @@unique([centerId, name])
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  action String

  @@unique([roleId, action])
}

// ---------------- Structure académique V2 ----------------

model ProgramType {
  id       String    @id @default(cuid())
  centerId String
  center   Center    @relation(fields: [centerId], references: [id])
  code     String    // "DQP", "CQP"
  label    String
  filieres Filiere[]

  @@unique([centerId, code])
}

model Filiere {
  id                 String               @id @default(cuid())
  centerId           String
  center             Center               @relation(fields: [centerId], references: [id])
  programTypeId      String
  programType        ProgramType          @relation(fields: [programTypeId], references: [id])
  name               String
  durationInYears    Int
  niveaux            Niveau[]
  promotions         Promotion[]
  classes            Classe[]
  subjects           FiliereSubject[]
  filiereMockSubjects FiliereMockSubject[]
  gradingPolicies    GradingPolicy[]
}

model Niveau {
  id        String    @id @default(cuid())
  filiereId String
  filiere   Filiere   @relation(fields: [filiereId], references: [id])
  order     Int       // 1, 2, 3
  classes   Classe[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  label     String   // "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  status    String   @default("UPCOMING") // "UPCOMING" | "CURRENT" | "CLOSED"

  promotions       Promotion[]
  classes          Classe[]
  inscriptions     Inscription[]
  gradePeriods     GradePeriod[]
  mockExamSessions MockExamSession[]

  @@unique([centerId, label])
}

model Promotion {
  id              String       @id @default(cuid())
  centerId        String
  center          Center       @relation(fields: [centerId], references: [id])
  filiereId       String
  filiere         Filiere      @relation(fields: [filiereId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  label           String
  expectedEndYear String?
  createdAt       DateTime     @default(now())

  inscriptions    Inscription[]

  @@unique([centerId, filiereId, academicYearId])
}

model Salle {
  id       String   @id @default(cuid())
  centerId String
  center   Center   @relation(fields: [centerId], references: [id])
  name     String
  capacity Int?
  classes  Classe[]
}

model Classe {
  id             String       @id @default(cuid())
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id])
  filiereId      String
  filiere        Filiere      @relation(fields: [filiereId], references: [id])
  niveauId       String
  niveau         Niveau       @relation(fields: [niveauId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  salleId        String?
  salle          Salle?       @relation(fields: [salleId], references: [id])
  label          String

  inscriptions     Inscription[]
  subjectOfferings SubjectOffering[]
  deliberations    Deliberation[]
  presences        Presence[]
  classeMockExams  ClasseMockExam[]

  @@unique([filiereId, niveauId, academicYearId])
}

model Student {
  id             String    @id @default(cuid())
  centerId       String
  center         Center    @relation(fields: [centerId], references: [id])
  matricule      String
  firstName      String
  lastName       String
  gender         String?   // "M" | "F"
  birthDate      DateTime?
  birthPlace     String?
  phone          String?
  guardianName   String?
  guardianPhone  String?
  entryDiploma   String?
  photoPath      String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  inscriptions       Inscription[]
  grades             Grade[]
  subjectResults     SubjectResult[]
  presences          Presence[]
  stages             Stage[]
  deliberations      StudentDeliberation[]
  mockExamGrades     MockExamGrade[]
  mockExamSummaries  MockExamSummary[]

  @@unique([centerId, matricule])
}

model Inscription {
  id             String        @id @default(cuid())
  centerId       String
  center         Center        @relation(fields: [centerId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  classeId       String
  classe         Classe        @relation(fields: [classeId], references: [id])
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  promotionId    String?
  promotion      Promotion?    @relation(fields: [promotionId], references: [id])
  status         String        @default("en_cours")
  createdAt      DateTime      @default(now())

  @@unique([studentId, academicYearId])
}

// ---------------- PÉDAGOGIE V3 (Cours Normaux) ----------------

model SubjectCategory {
  id              String           @id @default(cuid())
  centerId        String
  center          Center           @relation(fields: [centerId], references: [id])
  name            String
  code            String?
  order           Int              @default(1)
  isEliminatory   Boolean          @default(false)
  createdAt       DateTime         @default(now())

  filiereSubjects FiliereSubject[]
  offerings       SubjectOffering[]

  @@unique([centerId, name])
}

model Subject {
  id               String           @id @default(cuid())
  centerId         String
  center           Center           @relation(fields: [centerId], references: [id])
  name             String
  code             String?
  createdAt        DateTime         @default(now())

  filiereTemplates FiliereSubject[]
  offerings        SubjectOffering[]
  subjectResults   SubjectResult[]

  @@unique([centerId, code])
}

model FiliereSubject {
  id                   String           @id @default(cuid())
  centerId             String
  center               Center           @relation(fields: [centerId], references: [id])
  filiereId            String
  filiere              Filiere          @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  niveauOrder          Int
  semesterOrder        Int
  subjectId            String
  subject              Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             SubjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  defaultCoefficient   Float            @default(2.0)
  defaultVolumeHoraire Int?

  @@unique([filiereId, niveauOrder, semesterOrder, subjectId])
}

model Formateur {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  firstName   String
  lastName    String
  email       String?
  phone       String?
  specialite  String?
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  offerings   SubjectOffering[]
}

model SubjectOffering {
  id            String           @id @default(cuid())
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id])
  classeId      String
  classe        Classe           @relation(fields: [classeId], references: [id], onDelete: Cascade)
  gradePeriodId String
  gradePeriod   GradePeriod      @relation(fields: [gradePeriodId], references: [id])
  categoryId    String?
  category      SubjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  formateurId   String?
  formateur     Formateur?       @relation(fields: [formateurId], references: [id], onDelete: SetNull)

  coefficient   Float            @default(2.0)
  volumeHoraire Int?
  isActive      Boolean          @default(true)

  grades        Grade[]

  @@unique([subjectId, classeId, gradePeriodId])
}

model GradingPolicy {
  id            String    @id @default(cuid())
  centerId      String
  center        Center    @relation(fields: [centerId], references: [id])
  filiereId     String?
  filiere       Filiere?  @relation(fields: [filiereId], references: [id])
  ccWeight      Float     @default(0.30)
  normalWeight  Float     @default(0.70)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([centerId, filiereId, effectiveFrom])
}

model GradePeriod {
  id             String       @id @default(cuid())
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  type           String       // "SEMESTRE" | "ANNUEL"
  order          Int
  label          String
  startDate      DateTime
  endDate        DateTime

  subjectOfferings SubjectOffering[]
  grades           Grade[]
  subjectResults   SubjectResult[]
  deliberations    Deliberation[]

  @@unique([centerId, academicYearId, type, order])
}

model Grade {
  id                String          @id @default(cuid())
  centerId          String
  center            Center          @relation(fields: [centerId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  subjectOfferingId String
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id])
  gradePeriodId     String
  gradePeriod       GradePeriod     @relation(fields: [gradePeriodId], references: [id])
  
  evaluationType    String          // "CC_TP" | "NORMALE" | "RATTRAPAGE"
  label             String?
  value             Float
  maxValue          Float           @default(20)
  isAbsent          Boolean         @default(false)
  absenceReason     String?
  createdAt         DateTime        @default(now())
}

model SubjectResult {
  id              String      @id @default(cuid())
  centerId        String
  center          Center      @relation(fields: [centerId], references: [id])
  studentId       String
  student         Student     @relation(fields: [studentId], references: [id])
  subjectId       String
  subject         Subject     @relation(fields: [subjectId], references: [id])
  gradePeriodId   String
  gradePeriod     GradePeriod @relation(fields: [gradePeriodId], references: [id])

  computationMode String
  ccAverage       Float?
  normalAverage   Float?
  ccWeight        Float
  normalWeight    Float
  gradingPolicyId String?
  coefficient     Float
  finalGrade      Float
  isLocked        Boolean     @default(false)
  computedAt      DateTime    @default(now())

  @@unique([studentId, subjectId, gradePeriodId])
}

model Deliberation {
  id            String      @id @default(cuid())
  centerId      String
  center        Center      @relation(fields: [centerId], references: [id])
  classeId      String
  classe        Classe      @relation(fields: [classeId], references: [id])
  gradePeriodId String
  gradePeriod   GradePeriod @relation(fields: [gradePeriodId], references: [id])
  scope         String      // "CC" | "NORMALE" | "SEMESTRE" | "ANNUEL"
  juryDate      DateTime

  studentResults StudentDeliberation[]

  @@unique([classeId, gradePeriodId, scope])
}

model StudentDeliberation {
  id             String       @id @default(cuid())
  deliberationId String
  deliberation   Deliberation @relation(fields: [deliberationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  moyenne        Float
  rang           Int
  decision       String
}

model Presence {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classeId  String
  classe    Classe   @relation(fields: [classeId], references: [id])
  date      DateTime
  present   Boolean  @default(true)
}

model Entreprise {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  name     String
  contact  String?
  stages   Stage[]
}

model Stage {
  id           String     @id @default(cuid())
  centerId     String
  center       Center     @relation(fields: [centerId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  startDate    DateTime
  endDate      DateTime
  evaluation   Float?
}

model DocumentTemplate {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  type     String
  config   Json
  isActive Boolean @default(true)

  @@unique([centerId, type])
}

model Document {
  id             String   @id @default(cuid())
  centerId       String
  center         Center   @relation(fields: [centerId], references: [id])
  type           String
  studentId      String?
  classeId       String?
  gradePeriodId  String?
  filePath       String
  fileHash       String
  renderSnapshot Json
  qrToken        String   @unique
  generatedAt    DateTime @default(now())

  @@index([centerId, studentId, type, gradePeriodId])
}

// ============================================================================
// MODULE EXAMENS BLANCS (ARCHITECTURE MIROIR COMPLÈTE)
// ============================================================================

// 1. Référentiel universel des épreuves d'examen blanc
model MockSubject {
  id                 String               @id @default(cuid())
  centerId           String
  center             Center               @relation(fields: [centerId], references: [id])
  code               String               // ex: "EPS", "MSP", "EPT", "EPP"
  name               String               // ex: "Éducation Physique & Sportive", "Matière Spécialité Pratique"
  defaultCoefficient Float                @default(2.0)
  createdAt          DateTime             @default(now())

  filiereMockSubjects    FiliereMockSubject[]
  classeMockExamSubjects ClasseMockExamSubject[]

  @@unique([centerId, code])
}

// 2. Attribution par filière (Maquette type avec coefs d'examen par défaut)
model FiliereMockSubject {
  id            String      @id @default(cuid())
  centerId      String
  center        Center      @relation(fields: [centerId], references: [id])
  filiereId     String
  filiere       Filiere     @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  mockSubjectId String
  mockSubject   MockSubject @relation(fields: [mockSubjectId], references: [id], onDelete: Cascade)
  coefficient   Float       @default(2.0)
  order         Int         @default(1)

  @@unique([filiereId, mockSubjectId])
}

// 3. Session d'Examen Blanc (Rattachée obligatoirement à l'année académique active)
model MockExamSession {
  id             String          @id @default(cuid())
  centerId       String
  center         Center          @relation(fields: [centerId], references: [id])
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  title          String          // ex: "EXAMEN REGIONAL DU DQP BLANC, SESSION DE 2026"
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean         @default(false)
  createdAt      DateTime        @default(now())

  classeMockExams ClasseMockExam[]

  @@index([centerId, academicYearId])
}

// 4. Examen Blanc instancié pour une classe lors d'une session
model ClasseMockExam {
  id                String          @id @default(cuid())
  centerId          String
  center            Center          @relation(fields: [centerId], references: [id])
  mockExamSessionId String
  mockExamSession   MockExamSession @relation(fields: [mockExamSessionId], references: [id], onDelete: Cascade)
  classeId          String
  classe            Classe          @relation(fields: [classeId], references: [id], onDelete: Cascade)
  isLocked          Boolean         @default(false)
  createdAt         DateTime        @default(now())

  subjects          ClasseMockExamSubject[]
  grades            MockExamGrade[]
  summaries         MockExamSummary[]

  @@unique([mockExamSessionId, classeId])
}

// 5. Épreuves attribuées à la classe pour la session (instanciées depuis la maquette de filière)
model ClasseMockExamSubject {
  id               String          @id @default(cuid())
  classeMockExamId String
  classeMockExam   ClasseMockExam  @relation(fields: [classeMockExamId], references: [id], onDelete: Cascade)
  mockSubjectId    String
  mockSubject      MockSubject     @relation(fields: [mockSubjectId], references: [id], onDelete: Restrict)
  coefficient      Float           @default(2.0)
  order            Int             @default(1)

  grades           MockExamGrade[]

  @@unique([classeMockExamId, mockSubjectId])
}

// 6. Notes des élèves inscrits (Note/20, Points Note*Coef, et statut 'M' d'absence)
model MockExamGrade {
  id                      String                @id @default(cuid())
  classeMockExamId        String
  classeMockExam          ClasseMockExam        @relation(fields: [classeMockExamId], references: [id], onDelete: Cascade)
  classeMockExamSubjectId String
  classeMockExamSubject   ClasseMockExamSubject @relation(fields: [classeMockExamSubjectId], references: [id], onDelete: Cascade)
  studentId               String
  student                 Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  score                   Float?                // Note brute / 20 (null si absence 'M' ou non saisie)
  points                  Float?                // Points pondérés = score * coefficient
  isAbsent                Boolean               @default(false) // true si noté 'M'
  absenceCode             String?               // "M" pour Manqué / Malade / Absent
  createdAt               DateTime              @default(now())

  @@unique([classeMockExamSubjectId, studentId])
}

// 7. Synthèse et Moyenne Finale / 20 de chaque élève pour le Bordereau MINEFOP
model MockExamSummary {
  id               String         @id @default(cuid())
  classeMockExamId String
  classeMockExam   ClasseMockExam @relation(fields: [classeMockExamId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalPoints      Float          @default(0)
  totalCoefs       Float          @default(0)
  average          Float          @default(0) // Moyenne Finale / 20
  rank             Int?
  decision         String?        // "ADMIS" | "REFUSE"

  @@unique([classeMockExamId, studentId])
}

// ---------------- Traçabilité & Notifications ----------------

model AuditLog {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String?
  channel   String   @default("internal")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}