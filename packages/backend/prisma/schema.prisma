generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Tenant racine ----------------

model Center {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  logo               String?
  email              String?
  phone              String?

  address            String?
  city               String?
  postalCode         String?
  country            String?
  website            String?
  registrationNumber String?
  directorName       String?
  directorTitle      String?
  description        String?

  subscriptionPlan   String   @default("local")
  maxStorage         BigInt?
  storageUsedBytes   BigInt   @default(0)
  storageCheckedAt   DateTime?
  createdAt          DateTime @default(now())

  users              User[]
  roles              Role[]
  settings           Setting[]
  subscription       Subscription?
  license            License?

  programTypes       ProgramType[]
  filieres           Filiere[]
  promotions         Promotion[]
  classes            Classe[]
  salles             Salle[]
  academicYears      AcademicYear[]
  subjects           Subject[]
  students           Student[]
  formateurs         Formateur[]
  inscriptions       Inscription[]
  gradingPolicies    GradingPolicy[]
  gradePeriods       GradePeriod[]
  grades             Grade[]
  subjectResults     SubjectResult[]
  deliberations      Deliberation[]
  presences          Presence[]

  entreprises        Entreprise[]
  stages             Stage[]

  documentTemplates  DocumentTemplate[]
  documents          Document[]

  auditLogs          AuditLog[]
  notifications      Notification[]
}

model Subscription {
  id         String    @id @default(cuid())
  centerId   String    @unique
  center     Center    @relation(fields: [centerId], references: [id])
  plan       String    @default("local")
  status     String    @default("active")
  expiresAt  DateTime?
  maxUsers   Int?
  maxStorage BigInt?
}

model License {
  id            String   @id @default(cuid())
  centerId      String   @unique
  center        Center   @relation(fields: [centerId], references: [id])
  signedPayload String
  publicKeyId   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

model Setting {
  id       String @id @default(cuid())
  centerId String
  center   Center @relation(fields: [centerId], references: [id])
  key      String
  value    Json

  @@unique([centerId, key])
}

// ---------------- Utilisateurs & RBAC ----------------

model User {
  id        String    @id @default(cuid())
  centerId  String
  center    Center    @relation(fields: [centerId], references: [id])
  roleId    String?
  role      Role?     @relation(fields: [roleId], references: [id])
  email     String
  password  String
  firstName String
  lastName  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([centerId, email])
}

model Role {
  id          String       @id @default(cuid())
  centerId    String
  center      Center       @relation(fields: [centerId], references: [id])
  name        String
  isSystem    Boolean      @default(false)
  users       User[]
  permissions Permission[]

  @@unique([centerId, name])
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  action String

  @@unique([roleId, action])
}

// ---------------- Structure académique V2 ----------------

model ProgramType {
  id       String    @id @default(cuid())
  centerId String
  center   Center    @relation(fields: [centerId], references: [id])
  code     String
  label    String
  filieres Filiere[]

  @@unique([centerId, code])
}

model Filiere {
  id              String        @id @default(cuid())
  centerId        String
  center          Center        @relation(fields: [centerId], references: [id])
  programTypeId   String
  programType     ProgramType   @relation(fields: [programTypeId], references: [id])
  name            String
  durationInYears Int
  niveaux         Niveau[]
  promotions      Promotion[]
  classes         Classe[]
}

model Niveau {
  id        String    @id @default(cuid())
  filiereId String
  filiere   Filiere   @relation(fields: [filiereId], references: [id])
  order     Int
  classes   Classe[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  label     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  promotions   Promotion[]
  classes      Classe[]
  inscriptions Inscription[]
  gradePeriods GradePeriod[]

  @@unique([centerId, label])
}

model Promotion {
  id              String       @id @default(cuid())
  centerId        String
  center          Center       @relation(fields: [centerId], references: [id])
  filiereId       String
  filiere         Filiere      @relation(fields: [filiereId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  label           String
  expectedEndYear String?
  createdAt       DateTime     @default(now())

  inscriptions    Inscription[]

  @@unique([centerId, filiereId, academicYearId])
}

model Salle {
  id       String   @id @default(cuid())
  centerId String
  center   Center   @relation(fields: [centerId], references: [id])
  name     String
  capacity Int?
  classes  Classe[]
}

model Classe {
  id             String       @id @default(cuid())
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id])
  filiereId      String
  filiere        Filiere      @relation(fields: [filiereId], references: [id])
  niveauId       String
  niveau         Niveau       @relation(fields: [niveauId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  salleId        String?
  salle          Salle?       @relation(fields: [salleId], references: [id])
  label          String

  inscriptions     Inscription[]
  subjectOfferings SubjectOffering[]
  deliberations    Deliberation[]
  presences        Presence[]

  @@unique([filiereId, niveauId, academicYearId])
}

// ---------------- Apprenant Enrichi (MINEFOP / Guichet) ----------------

model Student {
  id             String    @id @default(cuid())
  centerId       String
  center         Center    @relation(fields: [centerId], references: [id])
  matricule      String
  firstName      String
  lastName       String
  gender         String?   // "M" | "F"
  birthDate      DateTime?
  birthPlace     String?   // Lieu de naissance
  phone          String?   // Téléphone de l'apprenant
  guardianName   String?   // Parent / Tuteur légal
  guardianPhone  String?   // Contact d'urgence
  entryDiploma   String?   // Dernier diplôme obtenu (BEPC, CAP, Probatoire, BAC...)
  photoPath      String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  inscriptions   Inscription[]
  grades         Grade[]
  subjectResults SubjectResult[]
  presences      Presence[]
  stages         Stage[]
  deliberations  StudentDeliberation[]

  @@unique([centerId, matricule])
}

model Inscription {
  id             String        @id @default(cuid())
  centerId       String
  center         Center        @relation(fields: [centerId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  classeId       String
  classe         Classe        @relation(fields: [classeId], references: [id])
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  promotionId    String?
  promotion      Promotion?    @relation(fields: [promotionId], references: [id])
  status         String        @default("en_cours") // en_cours | admis | redouble | abandon | diplome
  createdAt      DateTime      @default(now())

  @@unique([studentId, academicYearId])
}

model Formateur {
  id        String  @id @default(cuid())
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id])
  firstName String
  lastName  String
  email     String?
  userId    String?
}

model Subject {
  id       String @id @default(cuid())
  centerId String
  center   Center @relation(fields: [centerId], references: [id])
  name     String
  code     String?

  offerings      SubjectOffering[]
  subjectResults SubjectResult[]

  @@unique([centerId, code])
}

model GradingPolicy {
  id            String    @id @default(cuid())
  centerId      String
  center        Center    @relation(fields: [centerId], references: [id])
  filiereId     String?
  ccWeight      Float     @default(0.30)
  normalWeight  Float     @default(0.70)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([centerId, filiereId, effectiveFrom])
}

model GradePeriod {
  id             String       @id @default(cuid())
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  type           String
  order          Int
  label          String
  startDate      DateTime
  endDate        DateTime

  subjectOfferings SubjectOffering[]
  grades           Grade[]
  subjectResults   SubjectResult[]
  deliberations    Deliberation[]

  @@unique([centerId, academicYearId, type, order])
}

model SubjectOffering {
  id            String      @id @default(cuid())
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  classeId      String
  classe        Classe      @relation(fields: [classeId], references: [id])
  gradePeriodId String
  gradePeriod   GradePeriod @relation(fields: [gradePeriodId], references: [id])
  coefficient   Float
  volumeHoraire Int?
  isActive      Boolean     @default(true)

  grades Grade[]

  @@unique([subjectId, classeId, gradePeriodId])
}

model Grade {
  id                String          @id @default(cuid())
  centerId          String
  center            Center          @relation(fields: [centerId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  subjectOfferingId String
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id])
  gradePeriodId     String
  gradePeriod       GradePeriod     @relation(fields: [gradePeriodId], references: [id])
  evaluationType    String
  label             String?
  value             Float
  maxValue          Float           @default(20)
  createdAt         DateTime        @default(now())
}

model SubjectResult {
  id            String      @id @default(cuid())
  centerId      String
  center        Center      @relation(fields: [centerId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  gradePeriodId String
  gradePeriod   GradePeriod @relation(fields: [gradePeriodId], references: [id])

  computationMode String
  ccAverage       Float?
  normalAverage   Float?
  ccWeight        Float?
  normalWeight    Float?
  gradingPolicyId String?

  coefficient   Float
  finalGrade    Float
  isLocked      Boolean     @default(false)
  computedAt    DateTime    @default(now())

  @@unique([studentId, subjectId, gradePeriodId])
}

model Deliberation {
  id            String      @id @default(cuid())
  centerId      String
  center        Center      @relation(fields: [centerId], references: [id])
  classeId      String
  classe        Classe      @relation(fields: [classeId], references: [id])
  gradePeriodId String
  gradePeriod   GradePeriod @relation(fields: [gradePeriodId], references: [id])
  scope         String
  juryDate      DateTime

  studentResults StudentDeliberation[]

  @@unique([classeId, gradePeriodId, scope])
}

model StudentDeliberation {
  id             String       @id @default(cuid())
  deliberationId String
  deliberation   Deliberation @relation(fields: [deliberationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  moyenne        Float
  rang           Int
  decision       String
}

model Presence {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classeId  String
  classe    Classe   @relation(fields: [classeId], references: [id])
  date      DateTime
  present   Boolean  @default(true)
}

model Entreprise {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  name     String
  contact  String?
  stages   Stage[]
}

model Stage {
  id           String     @id @default(cuid())
  centerId     String
  center       Center     @relation(fields: [centerId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  startDate    DateTime
  endDate      DateTime
  evaluation   Float?
}

model DocumentTemplate {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id])
  type     String
  config   Json
  isActive Boolean @default(true)

  @@unique([centerId, type])
}

model Document {
  id             String   @id @default(cuid())
  centerId       String
  center         Center   @relation(fields: [centerId], references: [id])
  type           String
  studentId      String?
  classeId       String?
  filePath       String
  fileHash       String
  renderSnapshot Json
  qrToken        String   @unique
  generatedAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  userId    String?
  channel   String   @default("internal")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}